generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  username          String             @unique
  password          String
  email             String?            @unique
  createdAt         DateTime           @default(now())
  candidates        Candidate[]
  articles          Article[]
  dailyBriefs       DailyBrief[]
  generatedContents GeneratedContent[]
}

model GeneratedContent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  content   String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

model Candidate {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  name         String
  race         String
  state        String
  party        String
  incumbent    Boolean  @default(false)
  createdAt    DateTime @default(now())
  // Geographic targeting
  raceLevel    String?  // federal | state | county | municipal
  district     String?  // CD number or state legislative district number
  county       String?  // county name
  city         String?  // city or municipality name
  zip          String?  // ZIP code for hyper-local targeting
  opponentName    String?  // opponent name for news tracking & analysis
  // Campaign details (for richer AI context)
  bio             String?  // short candidate bio / background
  topIssues       String?  // comma-separated top issues / priorities
  electionDate    String?  // YYYY-MM-DD of primary/general election
  websiteUrl      String?  // campaign website URL
  fundraisingGoal Float?   // total fundraising goal in dollars
  bins            Bin[]

  @@index([userId])
}

model Outlet {
  id       String    @id @default(cuid())
  name     String
  type     String    // News | Blog | Social | TV | Radio | Other
  reach    String?
  leaning  String?
  articles Article[]
}

model Article {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  title         String
  url           String
  datePublished DateTime
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  author        String?
  language      String   @default("en")
  region        String?
  sourceType    String   // News | Blog | Social | PressRelease
  rawText       String
  summary       String?
  bucket        String?  // CandidateCoverage | OpponentCoverage | GeneralRace | HotButtons
  topics        String   @default("[]") // JSON array stored as string
  sentiment     String?  // Positive | Neutral | Negative
  confidence    Float?
  createdAt     DateTime @default(now())
  binItems      BinItem[]

  @@unique([url, userId])
  @@index([userId])
}

model Bin {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  name        String
  dateCreated DateTime  @default(now())
  digest      String?
  items       BinItem[]
  briefs      Brief[]
  exports     Export[]
}

model BinItem {
  id        String  @id @default(cuid())
  binId     String
  bin       Bin     @relation(fields: [binId], references: [id])
  articleId String
  article   Article @relation(fields: [articleId], references: [id])
  sortOrder Int     @default(0)

  @@unique([binId, articleId])
}

model Brief {
  id         String   @id @default(cuid())
  binId      String
  bin        Bin      @relation(fields: [binId], references: [id])
  type       String   // DailyDigest | IssueBrief | NeedToKnow | Newsletter | Email | SocialCopy | EventRequest
  content    String
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])
  createdAt  DateTime @default(now())
}

model Template {
  id             String  @id @default(cuid())
  name           String
  type           String
  structure      String  // JSON: sections + placeholders
  defaultContent String
  briefs         Brief[]
}

model Export {
  id          String   @id @default(cuid())
  binId       String
  bin         Bin      @relation(fields: [binId], references: [id])
  format      String   // CSV | JSON | Markdown
  content     String
  generatedAt DateTime @default(now())
  status      String   @default("ready")
}

model MediaPack {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String   // JSON
  createdAt DateTime @default(now())
}

model DailyBrief {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  date      String   // YYYY-MM-DD
  content   String
  createdAt DateTime @default(now())

  @@unique([date, userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  meta      String?
  createdAt DateTime @default(now())
}

model Contact {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  candidateId String?
  name        String
  phone       String?
  email       String?
  address     String?
  method      String   @default("phone")     // door | phone | text | email
  status      String   @default("completed") // completed | attempted | pending
  contactedAt DateTime @default(now())
  notes       String?

  @@index([candidateId])
}

model Donor {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  candidateId String?
  name        String
  email       String?
  phone       String?
  amount      Float     @default(0)
  donatedAt   DateTime  @default(now())
  method      String?   // online | check | cash | card
  followUpDue DateTime?
  notes       String?
  status      String    @default("received") // received | follow_up_needed | thanked
  employer    String?   // required for FEC itemization at $200+
  occupation  String?   // required for FEC itemization at $200+

  @@index([candidateId])
}

model Volunteer {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  candidateId String?
  name        String
  email       String?
  phone       String?
  role        String?
  shiftDate   DateTime
  shiftStart  String?
  shiftEnd    String?
  status      String   @default("scheduled") // scheduled | confirmed | completed | no_show
  notes       String?

  @@index([candidateId])
}

model CampaignEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  candidateId String?
  title       String
  type        String   @default("event") // rally | townhall | fundraiser | canvass | debate | meeting
  eventDate   DateTime
  location    String?
  description String?
  status      String   @default("upcoming") // upcoming | completed | cancelled

  @@index([candidateId])
}

model ContentDraft {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  candidateId String?
  title       String
  type        String   @default("social") // social | email | press_release | ad | mailer
  content     String
  platform    String?
  status      String   @default("pending") // pending | approved | rejected
  notes       String?

  @@index([candidateId])
}

model BudgetTransaction {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  candidateId   String?
  type          String   // income | expense
  category      String   // Donations | In-Kind | Loan | Refund | Staff | Advertising | Events | Printing | Travel | Consulting | Legal | Office | Polling | Other
  amount        Float
  vendor        String?
  description   String?
  txDate        DateTime @default(now())
  paymentMethod String?  // check | card | cash | transfer | in-kind
  notes         String?

  @@index([candidateId])
}

model MediaContact {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  candidateId     String?
  name            String
  outlet          String
  role            String?        // Reporter | Editor | Producer | Anchor | Columnist | Blogger
  beat            String?        // Politics | Local | Business | Education | Crime | Health | etc.
  email           String?
  phone           String?
  twitter         String?
  notes           String?
  relationship    String         @default("cold") // cold | warm | ally | hostile
  lastContactedAt DateTime?
  outreach        PressOutreach[]

  @@index([candidateId])
}

model PressOutreach {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  candidateId    String?
  mediaContactId String
  mediaContact   MediaContact @relation(fields: [mediaContactId], references: [id], onDelete: Cascade)
  type           String       // pitch | press-release | follow-up | interview | quote-request | other
  subject        String?
  notes          String?
  status         String       @default("sent") // sent | responded | published | ignored | declined
  sentAt         DateTime     @default(now())

  @@index([candidateId])
  @@index([mediaContactId])
}

model Voter {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  candidateId     String?
  firstName       String
  lastName        String
  address         String?
  city            String?
  zip             String?
  phone           String?
  email           String?
  party           String?   // Republican | Democrat | Independent | Unknown
  supportLevel    String?   // Strong Support | Lean Support | Persuadable | Opposed | Unknown
  turnoutScore    Float?
  precinct        String?
  tags            String    @default("[]") // JSON array
  notes           String?
  lastContactedAt DateTime?
  contactStatus   String    @default("Not Contacted") // Not Contacted | Reached | Left Message | Wrong Number | Do Not Contact | Needs Follow-Up

  @@index([candidateId])
  @@index([party])
  @@index([contactStatus])
}

// ── Opposition Research ───────────────────────────────────────────────────────

model ThreatScan {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  candidateId String?
  threats     ThreatRecord[]

  @@index([candidateId])
}

model ThreatRecord {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  candidateId String?
  scanId      String?
  scan        ThreatScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  threat      String      // short name
  angle       String      // attack angle / framing
  why         String      // why it matters
  severity    String      @default("MEDIUM") // HIGH | MEDIUM | LOW
  response    String?     // generated counter-response (stored when drafted)
  dismissed   Boolean     @default(false)
  notes       String?     // campaign team notes

  @@index([candidateId])
  @@index([scanId])
}

// ── O.R. Dossier ─────────────────────────────────────────────────────────────

// ── Contact List Segmentation ─────────────────────────────────────────────────

model ContactList {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  candidateId String
  name        String
  description String?
  totalCount  Int           @default(0)
  contacts    ListContact[]
  segments    Segment[]

  @@index([candidateId])
}

model ListContact {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  listId          String
  list            ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  segmentId       String?
  segment         Segment?    @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  firstName       String
  lastName        String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  zip             String?
  party           String?
  supportLevel    String?
  notes           String?
  voterId         String?
  disposition     String?     // Called | NoAnswer | LeftVM | Committed | NotInterested | DoNotContact
  dispositionNote String?
  dispositionAt   DateTime?
  sortOrder       Int         @default(0)

  @@index([listId])
  @@index([segmentId])
}

model Segment {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  candidateId String
  listId      String
  list        ContactList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  name        String
  assignedTo  String?
  shareToken  String        @unique @default(cuid())
  totalCount  Int           @default(0)
  workedCount Int           @default(0)
  callScript  String?       @db.Text
  contacts    ListContact[]

  @@index([candidateId])
  @@index([listId])
  @@index([shareToken])
}

// ── O.R. Dossier ─────────────────────────────────────────────────────────────

model OppResearchEntry {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  candidateId String?
  type        String   // vote | quote | donor | affiliation | ad | other
  title       String
  detail      String   @db.Text
  date        DateTime?
  source      String?
  citation    String?
  tags        String   @default("[]") // JSON array

  @@index([candidateId])
  @@index([type])
}
